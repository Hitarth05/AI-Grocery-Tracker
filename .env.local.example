# Copy to .env.local and fill in.
#
# Local dev:  run `pnpm exec supabase start` and use the API URL + anon key it
#             prints (the local anon key is the same on every machine).
# Hosted:     Supabase dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where magic-link emails send the user back to. Set to the deployed origin in
# production; leave as-is for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for photo extraction. Get one at console.anthropic.com -> API Keys.
# Server-side only: do NOT rename this with a NEXT_PUBLIC_ prefix, which would
# inline the key into the browser bundle and publish it.
ANTHROPIC_API_KEY=
