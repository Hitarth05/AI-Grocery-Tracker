# Copy to .env.local and fill in.
#
# Local dev:  run `pnpm exec supabase start` and use the API URL + anon key it
#             prints (the local anon key is the same on every machine).
# Hosted:     Supabase dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where magic-link emails send the user back to. Set to the deployed origin in
# production; leave as-is for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not used yet — the vision extraction in src/app/api/extract/route.ts is a stub.
# ANTHROPIC_API_KEY=
